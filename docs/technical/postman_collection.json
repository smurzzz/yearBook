{
  "info": {
    "name": "YearbookHub API v1",
    "description": "Every endpoint from docs/technical/api.md. Set API_URL ({API_URL}={API_ROOT}/api/v1), API_ROOT (http://localhost:3000), TOKEN (fresh Clerk session token — dev builds only) and CRON_SECRET. All routes except GET /health and GET /api/cron/daily require Authorization: Bearer {{TOKEN}}; students call student endpoints, admins call /admin/*.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "API_ROOT",
      "value": "http://localhost:3000"
    },
    {
      "key": "API_URL",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "TOKEN",
      "value": ""
    },
    {
      "key": "CRON_SECRET",
      "value": ""
    }
  ],

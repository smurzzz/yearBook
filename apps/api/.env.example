# YearbookHub API — environment template (docs/technical/environment.md §3.1)
# Copy to .env.local:  cp apps/api/.env.example apps/api/.env.local
# Parsed fail-fast by lib/env.ts (zod) once T-013 lands. Never commit real values.

# --- Clerk (server) ---
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# --- Database (Supabase pooler, port 6543 in prod; local: postgresql://postgres:postgres@127.0.0.1:54322/postgres) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Supabase ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=xxx   

# --- Storage ---
STORAGE_BUCKET=yearbook-photos

# --- Optional ---
ALLOWED_EMAIL_DOMAINS=
CRON_SECRET=change-me-long-random-string
STORAGE_SOFT_LIMIT_BYTES=943718400
SIGNED_URL_TTL_SECONDS=3600
EXPO_ACCESS_TOKEN=
MAINTENANCE_MODE=false
APP_TIMEZONE=Asia/Manila

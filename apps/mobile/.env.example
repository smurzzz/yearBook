# YearbookHub mobile — environment template (docs/technical/environment.md §3.2)
# Copy to .env:  cp apps/mobile/.env.example apps/mobile/.env
# EXPO_PUBLIC_* values are PUBLIC in the bundle — never put secrets here.

# API base URL: http://<laptop-LAN-IP>:3000 locally (not localhost on a physical phone), HTTPS in prod
EXPO_PUBLIC_API_URL=http://192.168.100.133:3000

# Clerk publishable key only
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Selects mock vs HTTP client in src/api (phases.md P3)
EXPO_PUBLIC_USE_MOCK=true
